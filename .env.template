# ==========================================================================
# MySEOapp — environment template. Copy to `.env` and fill in real values.
# NEVER commit a real .env. All backend vars use the SEO_ prefix.
# ==========================================================================

# ---- App ----
SEO_APP_NAME=MySEOapp API
SEO_ENVIRONMENT=development
SEO_DEBUG=false
SEO_LOG_LEVEL=INFO
SEO_LOG_JSON=true
# Comma-separated list is fine via JSON array in real .env, e.g. ["https://app.scalingfirm.com"]
SEO_CORS_ALLOW_ORIGINS=["*"]

# ---- Crawler ----
SEO_CRAWLER_USER_AGENT=MySEOappBot/0.1 (+https://scalingfirm.com/bot)
SEO_CRAWLER_MAX_PAGES=500
SEO_CRAWLER_MAX_DEPTH=10
SEO_CRAWLER_MAX_CONCURRENCY=10
SEO_CRAWLER_TIMEOUT_SECONDS=15
SEO_CRAWLER_RESPECT_ROBOTS=true

# ---- Rate limiting ----
SEO_RATE_LIMIT_ENABLED=true
SEO_RATE_LIMIT_REQUESTS=120
SEO_RATE_LIMIT_WINDOW_SECONDS=60

# ---- Data providers (pluggable: "mock" or a real adapter) ----
SEO_KEYWORD_PROVIDER=mock
SEO_SERP_PROVIDER=mock
# DataForSEO (optional real SERP/keyword source)
SEO_DATAFORSEO_LOGIN=
SEO_DATAFORSEO_PASSWORD=
# Google PageSpeed Insights / APIs
SEO_GOOGLE_API_KEY=
# Google Search Console service-account JSON (path or inline)
SEO_GSC_CREDENTIALS_JSON=

# ---- Integrations ----
# Make.com inbound webhook URL for outbound events (leads, audit-complete, etc.)
SEO_MAKE_WEBHOOK_URL=
SEO_MAKE_SIGNING_SECRET=
# Secret used to verify inbound webhooks (HMAC-SHA256)
SEO_WEBHOOK_SIGNING_SECRET=change-me-in-env
# CRM push target (pluggable: "mock" | "hubspot" | "salesforce")
SEO_CRM_PROVIDER=mock
SEO_CRM_API_KEY=
SEO_CRM_BASE_URL=
SEO_INTEGRATION_MAX_RETRIES=3

# ---- Database ----
# Dev default is SQLite; production should point at Postgres, e.g.
# postgresql+psycopg://user:pass@host:5432/myseoapp
SEO_DATABASE_URL=sqlite:///./myseoapp.db
SEO_DB_ECHO=false

# ---- Auth / Identity (delegated IdP + app-owned RBAC) ----
# IdP: "dev" (local HS256 tokens) | "clerk" | "supabase" | "auth0"
SEO_IDP_PROVIDER=dev
SEO_JWT_SECRET=change-me-in-env-super-secret
SEO_JWT_ALGORITHM=HS256
SEO_ACCESS_TOKEN_TTL_MINUTES=60
# Required for non-dev IdPs (RS256 verification against the IdP's JWKS)
SEO_IDP_JWKS_URL=
SEO_IDP_ISSUER=
SEO_IDP_AUDIENCE=
# Prefix for generated API keys (msk_...)
SEO_API_KEY_PREFIX=msk

# ---- Billing ----
# "mock" | "stripe" (stripe requires `pip install stripe` — see requirements.txt extras)
SEO_BILLING_PROVIDER=mock
SEO_STRIPE_API_KEY=
SEO_STRIPE_WEBHOOK_SECRET=
SEO_DEFAULT_PLAN_CODE=free
SEO_BILLING_TRIAL_DAYS=14

# ---- GEO (Generative Engine Optimization) ----
SEO_ANSWER_ENGINE_PROVIDER=mock
SEO_GEO_ARTIFACT_FETCHER=mock
SEO_OPENAI_API_KEY=
SEO_ANTHROPIC_API_KEY=
SEO_PERPLEXITY_API_KEY=

# ---- PEO / AEO ----
SEO_KG_PROVIDER=mock
SEO_GOOGLE_KG_API_KEY=
SEO_PROFILE_FETCHER_PROVIDER=mock
SEO_SERP_QUESTION_PROVIDER=mock

# ---- Kit assistant / Local SEO / Widget ----
SEO_CONTENT_GENERATOR_PROVIDER=mock
SEO_CMS_PROVIDER=mock
SEO_GBP_PROVIDER=mock
SEO_DIRECTORY_PROVIDER=mock
SEO_ASSISTANT_MAX_ATTEMPTS=3
SEO_ASSISTANT_APPROVAL_REQUIRED_DEFAULT=false
# JSON array of origins allowed to embed the lead-gen widget
SEO_WIDGET_ALLOWED_ORIGINS=["*"]
SEO_WIDGET_DEFAULT_ORG_SLUG=default

# ==========================================================================
# Frontend (Next.js) — prefix NEXT_PUBLIC_ for browser-exposed vars
# ==========================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ==========================================================================
# MCP server (TypeScript)
# ==========================================================================
MYSEOAPP_API_BASE_URL=http://localhost:8000
MYSEOAPP_API_KEY=

# ---- Background jobs ----
SEO_JOB_QUEUE_BACKEND=thread
SEO_JOB_QUEUE_WORKERS=4
SEO_JOB_MAX_ATTEMPTS=2
