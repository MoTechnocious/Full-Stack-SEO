{
  "name": "myseoapp-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing MySEOapp SEO tools (audit, on-page, keywords, SERP, rankings, reporting) over stdio.",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "bin": {
    "myseoapp-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
